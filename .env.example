# Copia este archivo a .env y rellená los valores reales.
# El archivo .env nunca debe subirse a git.

APP_TITLE=campaigns_events_service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Rate limiting por IP (ver src/rate_limit.py) — este servicio no lo llama el
# front, solo core_sms server-a-servidor (exento), así que es más una red de
# seguridad por defecto que protección activa.
RATE_LIMIT_DEFAULT=60/minute

# Secreto compartido simple (mismo patrón que billing_service/core_sms, ver
# billing_service/src/routes/internal.py) — valor que este servicio exige en
# el header X-Internal-Api-Key de requests entrantes (hoy: POST /events/campaigns
# llamado por core_sms).
INTERNAL_API_KEY=dev-internal-key

# core_sms — a donde le pegan los workers para reportar delivery status
# (ver workers/delivery_status_worker.py y services/core_sms_client.py).
# CORE_SMS_INTERNAL_API_KEY es el valor que core_sms exige en ESE header (debe
# ser igual al INTERNAL_API_KEY que core_sms define para esta ruta entrante,
# ver core_sms/.env.example).
CORE_SMS_URL=http://host.docker.internal:8300
CORE_SMS_INTERNAL_API_KEY=dev-internal-key
